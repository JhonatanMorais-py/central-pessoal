# Configuração pública do front-end
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
VITE_MAX_RECORDING_SECONDS=300
VITE_AI_ENABLED=false

# Token pessoal privado usado apenas pelo Supabase CLI.
# Não adicionar ao Render e nunca usar o prefixo VITE_ nesta variável.
SUPABASE_ACCESS_TOKEN=sbp_SUBSTITUA_PELO_TOKEN_PESSOAL
